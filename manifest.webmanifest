{
  "id": "/",
  "name": "Our Little Diary",
  "short_name": "Our Diary",
  "description": "A private little place to keep our photos, videos, voice notes, and letters.",
  "start_url": "/?source=installed-app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f8f0e4",
  "theme_color": "#172032",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "/icons/diary-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/diary-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/diary-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["image/*", "video/*", "audio/*"] }
      ]
    }
  }
}
